{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scribblerig",
  "compatibility_date": "2026-05-22",
  "main": "src/worker/index.ts",
  "observability": {
    "enabled": true
  },
  "assets": {
    // Defining `binding` makes the assets fetcher available to the worker
    // as `env.ASSETS`. The worker short-circuits static-asset prefixes
    // straight to this binding (see `src/worker/index.ts`).
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
